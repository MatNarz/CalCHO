<script>
 let total = 0; 
 let items = []; 
 const select = document.getElementById('alimento');
 const buscador = document.getElementById('buscador');

 // Buscador en tiempo real
 buscador.addEventListener('input', () => {
 const textoBusqueda = buscador.value.toLowerCase();
 for(let opcion of select.options) {
 const coincide = opcion.text.toLowerCase().includes(textoBusqueda);
 opcion.style.display = coincide ? 'block' : 'none';
 }
 select.selectedIndex = [].findIndex.call(select.options, op => op.style.display !== 'none');
 });

 // Conectar botones de forma segura
 document.getElementById('botonAgregar').addEventListener('click', agregarAlimento); 
 document.getElementById('botonLimpiar').addEventListener('click', limpiarComida); 

 function agregarAlimento() {
 const cantidad = parseFloat(document.getElementById('cantidad').value); 
 const carbosPorPorcion = parseFloat(select.value); 
 const nombreAlimento = select.options[select.selectedIndex].text.split(' ').slice(1).join(' '); 
 const totalPorItem = carbosPorPorcion * cantidad; 

 const idItem = Date.now(); 
 items.push({ id: idItem, nombre: nombreAlimento, cantidad, total: totalPorItem }); 
 total += totalPorItem; 

 renderizarLista(); 
 document.getElementById('cantidad').value = 1; 
 }

 function quitarItem(id) {
 const index = items.findIndex(item => item.id === id); 
 if (index !== -1) {
 total -= items[index].total; 
 items.splice(index, 1); 
 renderizarLista(); 
 }
 } 

 function renderizarLista() {
 const contenedor = document.getElementById('listaItems'); 
 contenedor.innerHTML = ''; 

 items.forEach(item => {
 const itemElemento = document.createElement('div'); 
 itemElemento.className = 'item-alimento'; 
 itemElemento.innerHTML = `
 <span>${item.cantidad}x ${item.nombre}</span>
 <div style="display:flex; gap:8px; align-items:center;">
 <span>${item.total.toFixed(1)}g</span>
 <button class="btn-quitar" onclick="quitarItem(${item.id})">Quitar</button>
 </div>
 `; 
 contenedor.appendChild(itemElemento); 
 }); 

 document.getElementById('totalCarbos').textContent = `${total.toFixed(1)} g`; 
 }

 function limpiarComida() {
 total = 0; 
 items = []; 
 renderizarLista(); 
 }
</script> 

